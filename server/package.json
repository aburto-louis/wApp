{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun --watch --env-file=../.env src/index.ts",
    "start": "bun --env-file=../.env src/index.ts",
    "db:migrate": "bun --env-file=../.env src/db/migrate.ts",
    "db:status": "bun --env-file=../.env src/db/migrate.ts --status",
    "db:reset": "rm -f src/db/data/db.sqlite*",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "store": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
